# Allow system_server to read Fast Charging status
allow system_server vendor_sysfs_battery_supply:file rw_file_perms;
allow system_server vendor_sysfs_battery_supply:file { getattr open read };

allow system_server vendor_sysfs_graphics:file rw_file_perms;

allow system_server shell:unix_stream_socket getopt;

# cached app optimizer
allow system_server audioserver_tmpfs:file write;
allow system_server vndbinder_device:chr_file write;

# Hypercharge
allow system_server vendor_sysfs_power_supply:file { read write open setattr getattr };
allow system_server vendor_sysfs_power_supply:dir search;

set_prop(system_server, bootloader_prop)
