# Camera
log.tag.CHIUSECASE=ERROR

# CNE
persist.vendor.cne.feature=1

# Display
debug.sf.frame_rate_multiple_threshold=120

# perf anim
persist.sys.activity_anim_perf_override=false

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# UserFaultFd Move
dalvik.vm.force_uffd_move=true

# Pinner
persist.sys.pinner.quota_pct=15

# LMK
ro.lmk.psi_partial_stall_ms=200
ro.lmk.psi_complete_stall_ms=700
ro.lmk.thrashing_limit=100
ro.lmk.thrashing_limit_decay=10
ro.lmk.thrashing_limit_critical=200
ro.lmk.swap_util_max=100
ro.lmk.kill_heaviest_task=0
ro.lmk.kill_timeout_ms=100

# QTI
ro.vendor.qti.va_aosp.support=1

# Radio
ril.subscription.types=NV,RUIM
persist.vendor.vonr_setting_support=1

# Sensors
persist.vendor.sensors.enable.mag_filter=true

# WiFi display
persist.debug.wfd.enable=1

# Increase max cached processes
activity_manager.max_cached_processes=64
